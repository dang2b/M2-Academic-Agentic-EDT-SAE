# Copier en .env pour personnaliser (facultatif)

# --- PostgreSQL ---
POSTGRES_USER=sae
POSTGRES_PASSWORD=sae
POSTGRES_DB=sae
POSTGRES_PORT=5432

# --- API ---
API_PORT=8000
# Front origins allowed to call the API, comma-separated
CORS_ORIGINS=http://localhost:3000
# Demo admin created at startup (local only)
DEMO_ADMIN_EMAIL=admin@example.com
DEMO_ADMIN_PASSWORD=admin1234

# --- Adminer (docker compose --profile tools up) ---
ADMINER_PORT=8080
